---
import Base from '../layouts/Base.astro';
import { manifest, rankings, gpuById, money, fmtDate, splitView, VIEW_LABELS } from '../lib/data';

const view = manifest.primary_view;
const { resolution, mode } = splitView(view);
const rows = rankings[view] ?? [];
const playable = rows.filter((r) => r.playable);
const zones = manifest.zones[view];
const snapshot = [playable[0], playable[1], playable.at(-1)].filter((r, i, all) => r && all.findIndex((a) => a?.gpu_id === r.gpu_id) === i);
const labels = ['Best value', 'Close second', 'Highest cost per FPS'];
const priceDates = [...new Set(rows.map((r) => gpuById[r.gpu_id]?.current_price?.fetched_at?.slice(0, 10)).filter((d): d is string => !!d))].sort();
const priceDate = priceDates.length ? `${fmtDate(priceDates[0])}${priceDates.length > 1 ? ` – ${fmtDate(priceDates.at(-1)!)}` : ''}` : 'Date unavailable';
const priceAge = priceDates.length ? Math.floor((Date.now() - new Date(priceDates[0]).getTime()) / 86400000) : null;
const priceCaution = priceAge === null || priceAge > 60;
const payload = {
  views: manifest.views, primary: view, zones: manifest.zones, priceDate,
  rankings: Object.fromEntries(manifest.views.map((v) => [v, (rankings[v] ?? []).map((r) => ({
    ...r, name: gpuById[r.gpu_id].display_name, vendor: gpuById[r.gpu_id].vendor,
  }))])),
};
const resolutions = ['1080p', '1440p', '4k'];
const modes = ['raster', 'rt'];
const available = new Set(manifest.views);
---

<Base title="SiliconValueIndex" theme="warm" description="Compare graphics card prices, frame rates and cost per FPS. Explore the market, then find a GPU for your budget and resolution.">
  <section class="overview-hero" aria-labelledby="overview-title">
    <div class="hero-copy">
      <h1 id="overview-title">Know what<br />a frame <em>is worth.</em></h1>
      <p class="hero-lede">Reviews rank cards by raw speed. SiliconValueIndex ranks them by price divided by frame rate, so you can see what your money buys.</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="/find/">Find a card for me <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6" /></svg></a>
        <a class="text-action" href="#board">Explore the market</a>
      </div>
      <p class="hero-footnote">Cost per FPS = recorded price ÷ average FPS. Lower is better.</p>
    </div>
    <aside class="market-snapshot" aria-labelledby="snapshot-heading">
      <h2 id="snapshot-heading">A little perspective.</h2>
      <p class="snapshot-context">{VIEW_LABELS[resolution]} Ultra · {mode === 'rt' ? 'Ray tracing' : 'Rasterization'}</p>
      <div class="snapshot-list">
        {snapshot.map((r, i) => r && (
          <a class="snapshot-row" href={`/gpu/${r.gpu_id}/`}>
            <span class="snapshot-card"><span class="snapshot-label">{labels[i]}</span><strong>{gpuById[r.gpu_id].display_name}</strong><span class="snapshot-spec">{money(r.price)} · {r.fps.toFixed(1)} FPS{r.normalized && ' (est.)'}</span></span>
            <span class={`snapshot-score zone-${r.zone}`}><span class="num">{money(r.cost_per_fps, 2)}</span><small>per FPS</small></span>
          </a>
        ))}
      </div>
      <p class="snapshot-note">Among cards meeting the {zones.min_fps} FPS minimum in this view.</p>
    </aside>
  </section>

  <div class="price-context">
    <span>Prices recorded <strong>{priceDate}</strong></span>
    <span>{priceCaution ? 'Older price snapshot. Check the retailer before buying.' : 'Prices can change. Check the retailer before buying.'} <a href="/data/">Data &amp; sources</a></span>
  </div>

  <section class="market-section" id="board" aria-labelledby="market-heading">
    <div class="market-heading">
      <div><h2 id="market-heading">The market, at a glance.</h2><p>Higher means faster. Further left means cheaper.</p></div>
      <a class="text-action" id="ranking-link" href={`/rankings/?view=${view}`}>See ranked list <span aria-hidden="true">→</span></a>
    </div>
    <div class="market-controls">
      <div class="control-field"><span class="control-label">Resolution</span><div class="seg" role="group" aria-label="Resolution">
        {resolutions.map((r) => <button type="button" data-res={r} aria-pressed={r === resolution} disabled={!modes.some((m) => available.has(`${r}_${m}`))}>{VIEW_LABELS[r]}</button>)}
      </div></div>
      <div class="control-field"><span class="control-label">Rendering</span><div class="seg" role="group" aria-label="Rendering mode">
        {modes.map((m) => <button type="button" data-mode={m} aria-pressed={m === mode} disabled={!resolutions.some((r) => available.has(`${r}_${m}`))}>{m === 'raster' ? 'Rasterization' : 'Ray tracing'}</button>)}
      </div></div>
      <p id="view-note" class="view-note" aria-live="polite">{playable.length} of {rows.length} cards meet the {zones.min_fps} FPS minimum.</p>
    </div>
    <figure class="market-chart">
      <svg id="scatter" role="group" aria-label="Graphics cards by recorded price and average frame rate" aria-describedby="chart-help"></svg>
      <figcaption id="legend">
        <span><i class="sw great" aria-hidden="true"></i>Great value <b id="great-label">under {money(zones.great_max, 2)}/FPS</b></span>
        <span><i class="sw fair" aria-hidden="true"></i>Fair <b id="fair-label">{money(zones.great_max, 2)}–{money(zones.fair_max, 2)}/FPS</b></span>
        <span><i class="sw poor" aria-hidden="true"></i>Poor <b id="poor-label">over {money(zones.fair_max, 2)}/FPS</b></span>
        <span><i class="sw hollow" aria-hidden="true"></i><span id="floor-label">Below {zones.min_fps} FPS</span></span>
      </figcaption>
    </figure>
    <p class="chart-help" id="chart-help">Select a dot to open its card. Dashed lines show the value thresholds; the shaded area is below the FPS minimum. These are test-suite averages, not a guarantee for every game.</p>
    <div class="chart-tooltip" id="tip" role="tooltip" hidden></div>
    <noscript><p>Enable JavaScript for the interactive chart. The recorded values are available in the table below.</p></noscript>
    <details class="chart-data"><summary>View chart data <span id="table-count">({rows.length} cards)</span></summary>
      <div class="table-scroll" tabindex="0" role="region" aria-label="Chart data table">
        <table class="table"><caption id="table-caption">{VIEW_LABELS[resolution]} Ultra · {VIEW_LABELS[mode]} · Recorded prices</caption>
          <thead><tr><th scope="col">Graphics card</th><th scope="col" class="n">Price</th><th scope="col" class="n">FPS</th><th scope="col" class="n">$/FPS</th><th scope="col">Minimum FPS</th></tr></thead>
          <tbody id="chart-rows">{rows.map((r) => <tr><th scope="row"><a href={`/gpu/${r.gpu_id}/`}>{gpuById[r.gpu_id].display_name}</a></th><td class="n">{money(r.price, 2)}</td><td class="n">{r.fps.toFixed(1)}{r.normalized && ' est.'}</td><td class="n">{money(r.cost_per_fps, 2)}</td><td>{r.playable ? 'Meets minimum' : 'Below minimum'}</td></tr>)}</tbody>
        </table>
      </div>
    </details>
  </section>

  <section class="reading-guide" aria-labelledby="guide-heading">
    <h2 id="guide-heading">A useful number.<br />With the context to trust it.</h2>
    <div class="guide-copy">
      <p><strong>Benchmarks, not promises.</strong> Frame rates are Tom’s Hardware’s averages across their test suite at Ultra settings. Your games and the rest of your system can change the result.</p>
      <p><strong>Measured or estimated.</strong> Older cards carry an “est.” label when their result has been translated to the current suite. <a href="/methodology/#normalization">See how normalization works.</a></p>
      <p><strong>Enough frames comes first.</strong> Cards below the selected view’s FPS minimum stay visible, but do not receive a value rating. Set your own target in <a href="/find/">Find a card</a>.</p>
      <a class="text-action" href="/methodology/#score">Read the methodology</a>
    </div>
  </section>
  <script is:inline type="application/json" id="svi-overview" set:html={JSON.stringify(payload)} />
</Base>

<script>
  import { renderScatter, attachTooltip, type ScatterRow, type ScatterZones } from '../lib/scatter';
  const data = JSON.parse(document.getElementById('svi-overview')!.textContent || '{}') as {
    views: string[]; primary: string; zones: Record<string, ScatterZones>; rankings: Record<string, ScatterRow[]>;
  };
  const svg = document.getElementById('scatter') as unknown as SVGSVGElement;
  const tip = document.getElementById('tip')!;
  const labels: Record<string, string> = { '1080p': '1080p', '1440p': '1440p', '4k': '4K', raster: 'Rasterization', rt: 'Ray tracing' };
  const money = (n: number, digits = 2) => n.toLocaleString('en-US', { style: 'currency', currency: 'USD', minimumFractionDigits: digits, maximumFractionDigits: digits });
  const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/"/g, '&quot;');
  const readView = () => { const v = new URLSearchParams(location.search).get('view'); return v && data.views.includes(v) ? v : data.primary; };
  let view = readView();
  const split = () => ({ res: view.slice(0, view.lastIndexOf('_')), mode: view.slice(view.lastIndexOf('_') + 1) });
  function draw() { const { res, mode } = split(); renderScatter(svg, data.rankings[view] ?? [], data.zones[view], `Average FPS · ${labels[res]} ${labels[mode]}`); tip.hidden = true; }
  function render() {
    const rows = data.rankings[view] ?? [], zones = data.zones[view];
    const { res, mode } = split();
    draw();
    document.querySelectorAll<HTMLButtonElement>('[data-res]').forEach((b) => { b.setAttribute('aria-pressed', String(b.dataset.res === res)); b.disabled = !data.views.includes(`${b.dataset.res}_${mode}`); });
    document.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((b) => { b.setAttribute('aria-pressed', String(b.dataset.mode === mode)); b.disabled = !data.views.includes(`${res}_${b.dataset.mode}`); });
    document.getElementById('view-note')!.textContent = `${rows.filter((r) => r.playable).length} of ${rows.length} cards meet the ${zones.min_fps} FPS minimum · ${labels[res]} Ultra.`;
    document.getElementById('great-label')!.textContent = `under ${money(zones.great_max)}/FPS`;
    document.getElementById('fair-label')!.textContent = `${money(zones.great_max)}–${money(zones.fair_max)}/FPS`;
    document.getElementById('poor-label')!.textContent = `over ${money(zones.fair_max)}/FPS`;
    document.getElementById('floor-label')!.textContent = `Below ${zones.min_fps} FPS`;
    document.getElementById('ranking-link')!.setAttribute('href', `/rankings/?view=${view}`);
    document.getElementById('table-count')!.textContent = `(${rows.length} cards)`;
    document.getElementById('table-caption')!.textContent = `${labels[res]} Ultra · ${labels[mode]} · Recorded prices`;
    document.getElementById('chart-rows')!.innerHTML = rows.map((r) => `<tr><th scope="row"><a href="/gpu/${esc(r.gpu_id)}/">${esc(r.name)}</a></th><td class="n">${money(r.price)}</td><td class="n">${r.fps.toFixed(1)}${r.normalized ? ' est.' : ''}</td><td class="n">${money(r.cost_per_fps)}</td><td>${r.playable ? 'Meets minimum' : 'Below minimum'}</td></tr>`).join('');
  }
  document.querySelector('.market-controls')!.addEventListener('click', (e) => {
    const button = (e.target as HTMLElement).closest('button');
    if (!button || button.disabled) return;
    const { res, mode } = split();
    const next = button.dataset.res ? `${button.dataset.res}_${mode}` : `${res}_${button.dataset.mode}`;
    if (!data.views.includes(next) || next === view) return;
    view = next;
    const url = new URL(location.href);
    if (view === data.primary) url.searchParams.delete('view'); else url.searchParams.set('view', view);
    history.pushState(null, '', url);
    render();
  });
  window.addEventListener('popstate', () => { view = readView(); render(); });
  render();
  attachTooltip(svg, tip);
  let width = svg.getBoundingClientRect().width;
  new ResizeObserver(() => { const next = svg.getBoundingClientRect().width; if (Math.abs(next - width) > 1) { width = next; draw(); } }).observe(svg);
</script>

<style is:global>
  .overview-hero { display: grid; grid-template-columns: 1.25fr 1fr; gap: clamp(40px, 7vw, 100px); align-items: center; padding: 24px 0 48px; }
  .hero-copy h1 { font-size: clamp(3rem, 5.5vw, 4.9rem); line-height: 1.04; letter-spacing: -0.035em; margin-bottom: 24px; }
  .hero-copy h1 em { color: var(--link); font-style: normal; }
  .hero-lede { color: var(--muted); font-size: 1.125rem; line-height: 1.7; max-width: 47ch; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 16px 24px; align-items: center; margin: 28px 0 18px; }
  .hero-actions .btn { padding: 12px 18px; min-height: 48px; }
  .text-action { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; text-decoration: underline; text-underline-offset: 5px; text-decoration-color: var(--rule-strong); }
  .text-action:hover { text-decoration-color: currentColor; }
  .hero-footnote { color: var(--dim); font-size: 0.8125rem; }
  .market-snapshot { border-top: 1px solid var(--link); padding-top: 24px; }
  .market-snapshot h2 { font-size: 1.9rem; margin-bottom: 8px; }
  .snapshot-context, .snapshot-note { color: var(--muted); font-size: 0.8125rem; }
  .snapshot-row { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 16px 0; border-top: 1px solid var(--rule); color: var(--text); }
  .snapshot-row:hover { text-decoration: none; background: var(--raised); }
  .snapshot-card { display: grid; gap: 3px; }
  .snapshot-card strong { font-size: 1rem; font-weight: 500; }
  .snapshot-label { color: var(--muted); font-size: 0.75rem; }
  .snapshot-spec { color: var(--dim); font-size: 0.8125rem; }
  .snapshot-score { display: grid; justify-items: end; gap: 2px; white-space: nowrap; }
  .snapshot-score .num { font-size: 1.6rem; }
  .snapshot-score small { font-size: 0.75rem; color: var(--muted); }
  .snapshot-note { margin: 12px 0 0; }
  .price-context { border-block: 1px solid var(--rule); padding-block: 15px; display: flex; justify-content: space-between; flex-wrap: wrap; gap: 6px 24px; font-size: 0.8125rem; color: var(--muted); }
  .price-context strong { color: var(--text); font-weight: 500; }
  .price-context a { margin-left: 8px; text-decoration: underline; text-underline-offset: 3px; }
  .market-section { padding-top: 44px; scroll-margin-top: 120px; }
  .market-heading { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-bottom: 24px; }
  .market-heading h2 { font-size: clamp(1.9rem, 3vw, 2.5rem); margin-bottom: 8px; }
  .market-heading p { color: var(--muted); margin: 0; }
  .market-controls { display: flex; flex-wrap: wrap; align-items: end; gap: 16px 28px; margin-bottom: 24px; }
  .control-field { display: grid; gap: 8px; }
  .control-label { font-size: 0.8125rem; color: var(--muted); }
  .market-controls .seg button { min-height: 44px; padding-inline: 18px; }
  .market-controls .seg button[aria-pressed='true'] { color: var(--ink); background: var(--link); }
  .market-controls .seg button:hover:not([aria-pressed='true']):not(:disabled) { background: var(--raised-2); }
  .market-controls .seg button:focus-visible { outline-offset: -4px; outline-color: currentColor; }
  .view-note { font-size: 0.8125rem; color: var(--muted); margin: 0 0 12px auto; max-width: 32ch; text-align: right; }
  .market-chart { margin: 0; padding: 24px 20px 20px; border: 1px solid var(--rule); border-radius: 12px; background: var(--raised); }
  .market-chart svg { width: 100%; height: auto; display: block; font-family: var(--font-num); }
  .market-chart .grid { stroke: var(--rule); stroke-width: 0.7; }
  .market-chart .tick { fill: var(--muted); font-size: 11px; }
  .market-chart .axis { fill: var(--muted); font-size: 12px; font-family: var(--font-ui); }
  .market-chart .iso { stroke: var(--rule-strong); stroke-width: 1; stroke-dasharray: 4 6; }
  .market-chart .floor-shade { fill: var(--ink); opacity: 0.5; }
  .market-chart .floor { stroke: var(--muted); stroke-width: 1; stroke-dasharray: 2 4; }
  .market-chart .floorlab { fill: var(--muted); font: 12px var(--font-ui); paint-order: stroke; stroke: var(--raised); stroke-width: 4px; }
  .market-chart .dot { stroke: var(--raised); stroke-width: 1.5; cursor: pointer; }
  .market-chart .z-great { fill: var(--great); }
  .market-chart .z-fair { fill: var(--fair); }
  .market-chart .z-poor { fill: var(--poor); }
  .market-chart .z-unplayable { fill: var(--raised); stroke: var(--dim); }
  .market-chart .point-link:hover .dot, .market-chart .point-link:focus .dot { stroke: var(--text); stroke-width: 3; r: 8; }
  .market-chart .dlabel { fill: var(--text); font: 500 12px var(--font-ui); paint-order: stroke; stroke: var(--raised); stroke-width: 4px; pointer-events: none; }
  .market-chart .label-leader { stroke: var(--dim); stroke-width: 0.7; pointer-events: none; }
  .market-chart figcaption { display: flex; flex-wrap: wrap; gap: 10px 24px; border-top: 1px solid var(--rule); padding-top: 18px; color: var(--text); font-size: 0.8125rem; }
  .market-chart figcaption b { color: var(--muted); font-weight: 400; margin-left: 4px; }
  .sw { display: inline-block; width: 9px; height: 9px; border-radius: 50%; margin-right: 6px; }
  .sw.great { background: var(--great); } .sw.fair { background: var(--fair); } .sw.poor { background: var(--poor); } .sw.hollow { border: 1px solid var(--dim); }
  .chart-help { font-size: 0.8125rem; color: var(--muted); margin: 14px 0 18px; max-width: 100ch; }
  .chart-tooltip { position: fixed; pointer-events: none; background: var(--text); color: var(--ink); padding: 12px 14px; border-radius: 6px; z-index: 60; font-size: 0.875rem; max-width: min(310px, calc(100vw - 16px)); box-shadow: 0 8px 24px #0003; }
  .chart-tooltip[hidden] { display: none; }
  .chart-data { border-block: 1px solid var(--rule); }
  .chart-data summary { padding: 16px 0; cursor: pointer; color: var(--link); }
  .chart-data summary span { color: var(--muted); font-size: 0.875rem; }
  .chart-data caption { padding: 16px 12px; text-align: left; color: var(--muted); }
  .chart-data th[scope='row'] { font-weight: 400; min-width: 180px; }
  .chart-data td { white-space: nowrap; }
  .reading-guide { padding-top: 56px; display: grid; grid-template-columns: 1fr 1.3fr; gap: 40px 80px; }
  .reading-guide h2 { font-size: clamp(1.9rem, 3vw, 2.5rem); }
  .guide-copy { color: var(--muted); }
  .guide-copy strong { color: var(--text); font-weight: 500; }
  .guide-copy p { margin-bottom: 20px; }
  @media (max-width: 760px) {
    .overview-hero { grid-template-columns: 1fr; gap: 32px; padding-top: 8px; padding-bottom: 32px; }
    .hero-copy h1 { max-width: 14ch; font-size: clamp(3rem, 9vw, 4.5rem); }
    .market-snapshot { max-width: none; }
    .market-heading { align-items: start; flex-direction: column; gap: 8px; }
    .market-heading .text-action { font-size: 0.875rem; }
    .view-note { margin: 0; text-align: left; max-width: none; width: 100%; }
    .market-chart { padding: 18px 8px; }
    .market-chart figcaption { padding-inline: 8px; gap: 10px 16px; }
    .reading-guide { grid-template-columns: 1fr; gap: 16px; padding-top: 40px; }
  }
</style>
