---
import Base from '../layouts/Base.astro';
import { manifest, rankings, gpus, retailerName, gpuById, ZONE_WORD, money, fmtDate, ageDays, STALE_DAYS, splitView, VIEW_LABELS } from '../lib/data';

import { pickVerdict, topList, picksHref } from '../lib/overview';

const view = manifest.primary_view;
const { resolution, mode } = splitView(view);
const rows = rankings[view] ?? [];
const playable = rows.filter((r) => r.playable);
const zones = manifest.zones[view];
const verdict = pickVerdict(rows, null);
const shortlist = topList(rows, null);
const priceContext = Object.fromEntries(manifest.views.map((v) => {
  const stamps = (rankings[v] ?? []).map((r) => gpuById[r.gpu_id]?.current_price?.fetched_at).filter((d): d is string => !!d).sort();
  const dates = [...new Set(stamps.map((d) => d.slice(0, 10)))];
  return [v, {
    date: dates.length ? fmtDate(dates[0]) + (dates.length > 1 ? ' – ' + fmtDate(dates.at(-1)!) : '') : 'Date unavailable',
    caution: !dates.length || ageDays(dates[0]) > STALE_DAYS,
    latest: stamps.at(-1) ?? null,
  }];
}));
const { date: priceDate, caution: priceCaution, latest: latestCheck } = priceContext[view];
const payload = {
  views: manifest.views, primary: view, zones: manifest.zones,
  gpus: gpus.map((g) => ({ current_price: g.current_price })),
  priceContext,
  rankings: Object.fromEntries(manifest.views.map((v) => [v, (rankings[v] ?? []).map((r) => ({
    ...r, name: gpuById[r.gpu_id].display_name, vendor: gpuById[r.gpu_id].vendor, current_price: gpuById[r.gpu_id].current_price, retailer_name: retailerName(gpuById[r.gpu_id].current_price?.retailer ?? ''),
  }))])),
};
const resolutions = ['1080p', '1440p', '4k'];
const modes = ['raster', 'rt'];
const available = new Set(manifest.views);
---

<Base title="SiliconValueIndex" theme="warm" description="Find the best value graphics card for your budget and resolution, with recorded prices and benchmark evidence.">
  <section class="overview-hero" aria-labelledby="overview-title">
    <p class="eyebrow">More frames for your money</p>
    <h1 id="overview-title">Best value at {VIEW_LABELS[resolution]}{mode === 'rt' ? ', ray tracing' : ''}</h1>
    <div id="verdict" aria-live="polite">
      {verdict ? <>
        <h2 class="verdict-name"><a href={`/gpu/${verdict.best.gpu_id}/`}>{gpuById[verdict.best.gpu_id].display_name}</a></h2>
        <p class={`verdict-score zone-${verdict.best.zone}`}><span class="num">{money(verdict.best.cost_per_fps, 2)}</span> <span>per FPS</span></p>
        <p class="verdict-stats"><span class="num">{money(verdict.best.price, 2)}</span> · {verdict.best.fps.toFixed(1)} FPS{verdict.best.normalized && ' est.'} · <span class={`zone-${verdict.best.zone}`}>{ZONE_WORD[verdict.best.zone]}</span></p>
        {gpuById[verdict.best.gpu_id].current_price?.url && <p class="retailer">{retailerName(gpuById[verdict.best.gpu_id].current_price!.retailer)} · <a href={gpuById[verdict.best.gpu_id].current_price!.url} target="_blank" rel="noopener">Check price</a></p>}
        {verdict.runnerUp && <p class="runner-up">Close second: <a href={`/gpu/${verdict.runnerUp.gpu_id}/`}>{gpuById[verdict.runnerUp.gpu_id].display_name}</a> · {money(verdict.runnerUp.cost_per_fps, 2)}/FPS</p>}
      </> : <p>No playable cards at this setting. <a href={picksHref(view, null, gpus)}>Find a card</a></p>}
    </div>
    <div class="price-context"><span>Prices recorded <strong id="price-date">{priceDate}</strong><span id="price-latest" hidden={!latestCheck}>, last updated <time datetime={latestCheck ?? ''} data-relative>{latestCheck ? fmtDate(latestCheck) : ''}</time></span>.</span> <span id="price-caution">{priceCaution ? 'Older price snapshot. Check the retailer before buying.' : 'Prices can change. Check the retailer before buying.'}</span> <a href="/data/">Data &amp; sources</a></div>
    <div class="market-controls">
      <div class="control-field"><span class="control-label">Resolution</span><div class="seg" role="group" aria-label="Resolution">
        {resolutions.map((r) => <button type="button" data-res={r} aria-pressed={r === resolution} disabled={!modes.some((m) => available.has(`${r}_${m}`))}>{VIEW_LABELS[r]}</button>)}
      </div></div>
      <div class="control-field"><span class="control-label">Rendering</span><div class="seg" role="group" aria-label="Rendering mode">
        {modes.map((m) => <button type="button" data-mode={m} aria-pressed={m === mode} disabled={!resolutions.some((r) => available.has(`${r}_${m}`))}>{m === 'raster' ? 'Rasterization' : 'Ray tracing'}</button>)}
      </div></div>
      <div class="control-field"><label class="control-label" for="overview-budget">Budget</label><select class="select" id="overview-budget"><option value="">Any</option>{[300, 400, 500, 700, 1000].map((n) => <option value={n}>{money(n)}</option>)}</select></div>
      <a class="btn btn-primary" id="picks-link" href={picksHref(view, null, gpus)}>See my picks</a>
      <p id="view-note" class="view-note" aria-live="polite">{playable.length} of {rows.length} cards meet the {zones.min_fps} FPS minimum.</p>
    </div>

  </section>
  <section class="market-snapshot" aria-labelledby="snapshot-heading">
    <div class="section-heading"><h2 id="snapshot-heading">Top 5 for this setting</h2><a id="ranking-link" href={`/rankings/?view=${view}`}>See all {rows.length} ranked</a></div>
    <p class="muted" id="snapshot-context">{VIEW_LABELS[resolution]} Ultra · {VIEW_LABELS[mode]}</p>
    <ol class="snapshot-list" id="snapshot-list">
      {shortlist.map((r) => <li class="snapshot-row"><span class="rank num">{r.rank}</span><a class="snapshot-name" href={`/gpu/${r.gpu_id}/`}>{gpuById[r.gpu_id].display_name}</a><span class="snapshot-price num">{money(r.price, 2)} <small>price</small></span><span class="snapshot-fps num">{r.fps.toFixed(1)} FPS{r.normalized && ' est.'}</span><span class={`snapshot-score zone-${r.zone}`}><span class="num">{money(r.cost_per_fps, 2)}/FPS</span><small>{ZONE_WORD[r.zone]}</small></span></li>)}
    </ol>
    <p class="muted small" id="snapshot-note">Among cards meeting the {zones.min_fps} FPS minimum in this view.</p>
  </section>
  <section class="market-section" id="board" aria-labelledby="market-heading">
    <h2 id="market-heading">The market, in perspective</h2><p class="muted">Higher means faster. Further left means cheaper.</p>
    <figure class="market-chart">
      <svg id="scatter" role="group" aria-label="Graphics cards by recorded price and average frame rate" aria-describedby="chart-help"></svg>
      <figcaption id="legend">
        <span><i class="sw great" aria-hidden="true"></i>Great value <b id="great-label">under {money(zones.great_max, 2)}/FPS</b></span>
        <span><i class="sw fair" aria-hidden="true"></i>Fair <b id="fair-label">{money(zones.great_max, 2)}–{money(zones.fair_max, 2)}/FPS</b></span>
        <span><i class="sw poor" aria-hidden="true"></i>Poor <b id="poor-label">over {money(zones.fair_max, 2)}/FPS</b></span>
        <span><i class="sw hollow" aria-hidden="true"></i><span id="floor-label">Below {zones.min_fps} FPS</span></span>
      </figcaption>
    </figure>
    <p class="chart-help" id="chart-help">Select a dot to open its card. Dashed lines show the value thresholds; the shaded area is below the FPS minimum. These are test-suite averages, not a guarantee for every game.</p>
    <div class="chart-tooltip" id="tip" role="tooltip" hidden></div>
    <noscript><p>Enable JavaScript for the interactive chart. The recorded values are available in the table below.</p></noscript>
    <details class="chart-data"><summary>View chart data <span id="table-count">({rows.length} cards)</span></summary>
      <div class="table-scroll" tabindex="0" role="region" aria-label="Chart data table">
        <table class="table"><caption id="table-caption">{VIEW_LABELS[resolution]} Ultra · {VIEW_LABELS[mode]} · Recorded prices</caption>
          <thead><tr><th scope="col">Graphics card</th><th scope="col" class="n">Price</th><th scope="col" class="n">FPS</th><th scope="col" class="n">$/FPS</th><th scope="col">Minimum FPS</th></tr></thead>
          <tbody id="chart-rows">{rows.map((r) => <tr><th scope="row"><a href={`/gpu/${r.gpu_id}/`}>{gpuById[r.gpu_id].display_name}</a></th><td class="n">{money(r.price, 2)}</td><td class="n">{r.fps.toFixed(1)}{r.normalized && ' est.'}</td><td class="n">{money(r.cost_per_fps, 2)}</td><td>{r.playable ? 'Meets minimum' : 'Below minimum'}</td></tr>)}</tbody>
        </table>
      </div>
    </details>
  </section>


  <section class="reading-guide" aria-labelledby="guide-heading">
    <h2 id="guide-heading">How to read this</h2>
    <div class="guide-copy">
      <p><strong>Benchmarks, not promises.</strong> Frame rates are Tom’s Hardware’s averages across their test suite at Ultra settings. Your games and the rest of your system can change the result.</p>
      <p><strong>Measured or estimated.</strong> Older cards carry an “est.” label when their result has been translated to the current suite. <a href="/methodology/#normalization">See how normalization works.</a></p>
      <p><strong>Enough frames comes first.</strong> Cards below the selected view’s FPS minimum stay visible, but do not receive a value rating. Set your own target in <a href="/find/">Find a card</a>.</p>
      <a class="text-action" href="/methodology/#score">Read the methodology</a>
    </div>
  </section>
  <script is:inline type="application/json" id="svi-overview" set:html={JSON.stringify(payload)} />
</Base>
<script>
  import { renderScatter, attachTooltip, type ScatterRow, type ScatterZones } from '../lib/scatter';
  import { pickVerdict, topList, picksHref } from '../lib/overview';
  import { relTime } from '../lib/relTime';
  import type { RankingRow, CurrentPrice } from '../lib/data';
  type OverviewRow = ScatterRow & RankingRow & { current_price: CurrentPrice | null; retailer_name: string };
  const zoneWords = { great: 'great value', fair: 'fair value', poor: 'poor value', unplayable: 'below playable' };
  let budget: number | null = null;
  const data = JSON.parse(document.getElementById('svi-overview')!.textContent || '{}') as {
    views: string[]; primary: string; zones: Record<string, ScatterZones>; rankings: Record<string, OverviewRow[]>; gpus: { current_price: CurrentPrice | null }[]; priceContext: Record<string, { date: string; caution: boolean; latest: string | null }>;
  };
  const svg = document.getElementById('scatter') as unknown as SVGSVGElement;
  const tip = document.getElementById('tip')!;
  const labels: Record<string, string> = { '1080p': '1080p', '1440p': '1440p', '4k': '4K', raster: 'Rasterization', rt: 'Ray tracing' };
  const money = (n: number, digits = 2) => n.toLocaleString('en-US', { style: 'currency', currency: 'USD', minimumFractionDigits: digits, maximumFractionDigits: digits });
  const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/"/g, '&quot;');
  const readView = () => { const v = new URLSearchParams(location.search).get('view'); return v && data.views.includes(v) ? v : data.primary; };
  let view = readView();
  const split = () => ({ res: view.slice(0, view.lastIndexOf('_')), mode: view.slice(view.lastIndexOf('_') + 1) });
  function draw() { const { res, mode } = split(); renderScatter(svg, data.rankings[view] ?? [], data.zones[view], `Average FPS · ${labels[res]} ${labels[mode]}`); tip.hidden = true; }
  function render() {
    const rows = data.rankings[view] ?? [], zones = data.zones[view];
    const { res, mode } = split();
    draw();
    const verdict = pickVerdict(rows, budget);
    const shortlist = topList(rows, budget);
    const href = picksHref(view, budget, data.gpus);
    document.getElementById('overview-title')!.textContent = `Best value at ${labels[res]}${mode === 'rt' ? ', ray tracing' : ''}`;
    document.getElementById('picks-link')!.setAttribute('href', href);
    document.getElementById('price-date')!.textContent = data.priceContext[view].date;
    const latest = data.priceContext[view].latest, latestEl = document.getElementById('price-latest')!;
    latestEl.hidden = !latest;
    if (latest) { const t = latestEl.querySelector('time')!; t.dateTime = latest; t.textContent = relTime(latest); }
    document.getElementById('price-caution')!.textContent = data.priceContext[view].caution ? 'Older price snapshot. Check the retailer before buying.' : 'Prices can change. Check the retailer before buying.';
    const empty = budget === null ? 'No playable cards at this setting.' : `No playable card under ${money(budget, 0)} at this setting.`;
    if (verdict) {
      const { best: b, runnerUp: r } = verdict;
      document.getElementById('verdict')!.innerHTML = `<h2 class="verdict-name"><a href="/gpu/${esc(b.gpu_id)}/">${esc(b.name)}</a></h2><p class="verdict-score zone-${b.zone}"><span class="num">${money(b.cost_per_fps)}</span> <span>per FPS</span></p><p class="verdict-stats"><span class="num">${money(b.price)}</span> · ${b.fps.toFixed(1)} FPS${b.normalized ? ' est.' : ''} · <span class="zone-${b.zone}">${zoneWords[b.zone]}</span></p>${b.current_price?.url ? `<p class="retailer">${esc(b.retailer_name)} · <a href="${esc(b.current_price.url)}" target="_blank" rel="noopener">Check price</a></p>` : ''}${r ? `<p class="runner-up">Close second: <a href="/gpu/${esc(r.gpu_id)}/">${esc(r.name)}</a> · ${money(r.cost_per_fps)}/FPS</p>` : ''}`;
    } else document.getElementById('verdict')!.innerHTML = `<p>${empty} <a href="${esc(href)}">Find a card</a></p>`;
    document.getElementById('snapshot-context')!.textContent = `${labels[res]} Ultra · ${labels[mode]}`;
    document.getElementById('snapshot-note')!.textContent = `Among cards meeting the ${zones.min_fps} FPS minimum in this view.`;
    document.getElementById('snapshot-list')!.innerHTML = shortlist.map((r) => `<li class="snapshot-row"><span class="rank num">${r.rank}</span><a class="snapshot-name" href="/gpu/${esc(r.gpu_id)}/">${esc(r.name)}</a><span class="snapshot-price num">${money(r.price)} <small>price</small></span><span class="snapshot-fps num">${r.fps.toFixed(1)} FPS${r.normalized ? ' est.' : ''}</span><span class="snapshot-score zone-${r.zone}"><span class="num">${money(r.cost_per_fps)}/FPS</span><small>${zoneWords[r.zone]}</small></span></li>`).join('') || `<li>${empty} <a href="${esc(href)}">Find a card</a></li>`;
    document.querySelectorAll<HTMLButtonElement>('[data-res]').forEach((b) => { b.setAttribute('aria-pressed', String(b.dataset.res === res)); b.disabled = !data.views.includes(`${b.dataset.res}_${mode}`); });
    document.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((b) => { b.setAttribute('aria-pressed', String(b.dataset.mode === mode)); b.disabled = !data.views.includes(`${res}_${b.dataset.mode}`); });
    document.getElementById('view-note')!.textContent = `${rows.filter((r) => r.playable).length} of ${rows.length} cards meet the ${zones.min_fps} FPS minimum · ${labels[res]} Ultra.`;
    document.getElementById('great-label')!.textContent = `under ${money(zones.great_max)}/FPS`;
    document.getElementById('fair-label')!.textContent = `${money(zones.great_max)}–${money(zones.fair_max)}/FPS`;
    document.getElementById('poor-label')!.textContent = `over ${money(zones.fair_max)}/FPS`;
    document.getElementById('floor-label')!.textContent = `Below ${zones.min_fps} FPS`;
    document.getElementById('ranking-link')!.setAttribute('href', `/rankings/?view=${view}`);
    document.getElementById('ranking-link')!.textContent = `See all ${rows.length} ranked`;
    document.getElementById('table-count')!.textContent = `(${rows.length} cards)`;
    document.getElementById('table-caption')!.textContent = `${labels[res]} Ultra · ${labels[mode]} · Recorded prices`;
    document.getElementById('chart-rows')!.innerHTML = rows.map((r) => `<tr><th scope="row"><a href="/gpu/${esc(r.gpu_id)}/">${esc(r.name)}</a></th><td class="n">${money(r.price)}</td><td class="n">${r.fps.toFixed(1)}${r.normalized ? ' est.' : ''}</td><td class="n">${money(r.cost_per_fps)}</td><td>${r.playable ? 'Meets minimum' : 'Below minimum'}</td></tr>`).join('');
  }
  document.querySelector('.market-controls')!.addEventListener('click', (e) => {
    const button = (e.target as HTMLElement).closest('button');
    if (!button || button.disabled) return;
    const { res, mode } = split();
    const next = button.dataset.res ? `${button.dataset.res}_${mode}` : `${res}_${button.dataset.mode}`;
    if (!data.views.includes(next) || next === view) return;
    view = next;
    const url = new URL(location.href);
    if (view === data.primary) url.searchParams.delete('view'); else url.searchParams.set('view', view);
    history.pushState(null, '', url);
    render();
  });
  document.getElementById('overview-budget')!.addEventListener('change', (e) => { const value = (e.target as HTMLSelectElement).value; budget = value ? Number(value) : null; render(); });
  window.addEventListener('popstate', () => { view = readView(); render(); });
  render();
  attachTooltip(svg, tip);
  let width = svg.getBoundingClientRect().width;
  new ResizeObserver(() => { const next = svg.getBoundingClientRect().width; if (Math.abs(next - width) > 1) { width = next; draw(); } }).observe(svg);
</script>

<style is:global>
  .overview-hero { padding: 0 0 var(--space-5); }
  .eyebrow { color: var(--muted); font-size: .875rem; margin-bottom: 16px; }
  .overview-hero h1 { max-width: 20ch; margin-bottom: 24px; }
  .verdict-name { font-size: clamp(1.5rem, 3vw, 2rem); margin-bottom: 12px; }
  .verdict-name a { color: var(--text); }
  .verdict-score { margin: 0 0 12px; }
  .verdict-score .num { font-size: clamp(2.5rem, 5vw, 4rem); letter-spacing: -.05em; line-height: 1.1; }
  .verdict-score > span:last-child { font-size: 1rem; }
  .verdict-stats, .retailer, .runner-up { margin-bottom: 8px; }
  .runner-up, .price-context { color: var(--muted); font-size: .875rem; }
  .price-context { margin-top: 16px; max-width: 85ch; }
  .market-controls { display: flex; flex-wrap: wrap; align-items: end; gap: 16px; margin-top: 28px; }
  .control-field { display: grid; gap: 8px; }
  .control-label { color: var(--muted); font-size: .8125rem; }
  .view-note { flex-basis: 100%; color: var(--muted); font-size: .8125rem; margin: 0; }
  .section-heading { display: flex; flex-wrap: wrap; gap: 12px; align-items: baseline; justify-content: space-between; }
  .market-snapshot, .market-section, .reading-guide { border-top: 1px solid var(--rule); padding-top: 32px; margin-top: 24px; }
  .snapshot-list { padding: 0; margin: 20px 0; list-style: none; }
  .snapshot-row { display: grid; grid-template-columns: 2rem minmax(0, 1fr) 9rem 10rem 10rem; gap: 16px; align-items: center; border-top: 1px solid var(--rule); padding: 20px 0; }
  .snapshot-name { color: var(--text); font-weight: 500; }
  .snapshot-price, .snapshot-fps, .snapshot-score { text-align: right; }
  .snapshot-price small { font-family: var(--font-ui); color: var(--muted); }
  .snapshot-score small { display: block; }
  .rank { color: var(--dim); }
  .market-chart { margin: 24px 0; }
  .market-chart svg { width: 100%; height: auto; display: block; font-family: var(--font-mono); }
  .market-chart .grid { stroke: var(--rule); stroke-width: 0.7; }
  .market-chart .tick { fill: var(--muted); font-size: 11px; }
  .market-chart .axis { fill: var(--muted); font-size: 12px; font-family: var(--font-ui); }
  .market-chart .iso { stroke: var(--rule-strong); stroke-width: 1; stroke-dasharray: 4 6; }
  .market-chart .floor-shade { fill: var(--ink); opacity: 0.5; }
  .market-chart .floor { stroke: var(--muted); stroke-width: 1; stroke-dasharray: 2 4; }
  .market-chart .floorlab { fill: var(--muted); font: 12px var(--font-ui); paint-order: stroke; stroke: var(--raised); stroke-width: 4px; }
  .market-chart .dot { stroke: var(--raised); stroke-width: 1.5; cursor: pointer; }
  .market-chart .z-great { fill: var(--great); }
  .market-chart .z-fair { fill: var(--fair); }
  .market-chart .z-poor { fill: var(--poor); }
  .market-chart .z-unplayable { fill: var(--raised); stroke: var(--dim); }
  .market-chart .point-link:hover .dot, .market-chart .point-link:focus .dot { stroke: var(--text); stroke-width: 3; r: 8; }
  .market-chart .dlabel { fill: var(--text); font: 500 12px var(--font-ui); paint-order: stroke; stroke: var(--raised); stroke-width: 4px; pointer-events: none; }
  .market-chart .label-leader { stroke: var(--dim); stroke-width: 0.7; pointer-events: none; }
  .market-chart figcaption { display: flex; flex-wrap: wrap; gap: 10px 24px; border-top: 1px solid var(--rule); padding-top: 18px; color: var(--text); font-size: 0.8125rem; }
  .market-chart figcaption b { color: var(--muted); font-weight: 400; margin-left: 4px; }
  .sw { display: inline-block; width: 9px; height: 9px; border-radius: 50%; margin-right: 6px; }
  .sw.great { background: var(--great); } .sw.fair { background: var(--fair); } .sw.poor { background: var(--poor); } .sw.hollow { border: 1px solid var(--dim); }
  .chart-help { font-size: 0.8125rem; color: var(--muted); margin: 14px 0 18px; max-width: 100ch; }
  .chart-tooltip { position: fixed; pointer-events: none; background: var(--text); color: var(--ink); padding: 12px 14px; border-radius: 6px; z-index: 60; font-size: 0.875rem; max-width: min(310px, calc(100vw - 16px)); box-shadow: 0 8px 24px #0003; }
  .chart-tooltip[hidden] { display: none; }
  .chart-data { border-block: 1px solid var(--rule); }
  .chart-data summary { padding: 16px 0; cursor: pointer; color: var(--link); }
  .chart-data summary span { color: var(--muted); font-size: 0.875rem; }
  .chart-data caption { padding: 16px 12px; text-align: left; color: var(--muted); }
  .chart-data th[scope='row'] { font-weight: 400; min-width: 180px; }
  .chart-data td { white-space: nowrap; }

  .reading-guide h2 { margin-bottom: 24px; }
  .guide-copy { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; color: var(--muted); }
  .guide-copy strong { display: block; color: var(--text); margin-bottom: 8px; }
  .guide-copy > a { grid-column: 1 / -1; }
  @media (max-width: 760px) {
    .overview-hero h1 { margin-bottom: 20px; }
    .snapshot-row { grid-template-columns: 1.5rem minmax(0, 1fr) minmax(0, 1fr); gap: 8px 12px; }
    .snapshot-row .rank { grid-column: 1; grid-row: 1; }
    .snapshot-name { grid-column: 2 / 4; }
    .snapshot-price { grid-column: 2; text-align: left; font-size: .875rem; }
    .snapshot-fps { grid-column: 3; font-size: .875rem; }
    .snapshot-score { grid-column: 2 / 4; text-align: left; }
    .snapshot-score small { display: inline; margin-left: 12px; }
    .guide-copy { grid-template-columns: 1fr; }
  }
</style>
